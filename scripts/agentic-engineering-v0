#!/usr/bin/env python3
"""Run the Agentic Engineering personal V0 from the repository."""
from __future__ import annotations

import runpy
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
sys.path.insert(0, str(SRC))
runpy.run_path(str(SRC / "agentic_engineering_v0.py"), run_name="__main__")
